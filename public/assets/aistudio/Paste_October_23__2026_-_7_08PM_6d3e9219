<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>RFF² — Roblox Football Federation · Official Registry (271 Athletes)</title>
  
  <!-- Typography -->
  <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://api.fontshare.com/v2/css?f[]=clash-display@400,500,600,700&f[]=switzer@400,500,600,700&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            ink: '#05050a',
            panel: '#0d0d12',
            'panel-2': '#13131a',
            fog: '#9a9aa4',
            mist: '#6d6d76',
            crimson: '#e11d48',
            ember: '#ff4d61',
            gold: '#ffb02e',
            founder: '#c084fc',
            roblox: '#00a2ff'
          },
          fontFamily: {
            display: ['"Clash Display"', '"Archivo"', 'system-ui', 'sans-serif'],
            body: ['"Switzer"', 'system-ui', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'ui-monospace', 'monospace']
          }
        }
      }
    };
  </script>

  <style>
    /* Main RFF Stadium Background */
    body {
      background-color: #05050a;
      background-image: url("/images/rff-bg.jpg"), url("images/rff-bg.jpg"), url("./images/rff-bg.jpg");
      background-size: cover;
      background-position: center top;
      background-attachment: fixed;
      background-repeat: no-repeat;
      color: #f5f5f7;
      font-family: "Switzer", system-ui, sans-serif;
      overflow-x: hidden;
      min-height: 100vh;
    }

    /* Cinematic Stadium Overlay so text and glass panels pop */
    body::before {
      content: "";
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      background: linear-gradient(
        180deg,
        rgba(5, 5, 10, 0.88) 0%,
        rgba(5, 5, 10, 0.72) 35%,
        rgba(5, 5, 10, 0.92) 100%
      );
    }

    /* Translucent Glass Panels */
    .glass-panel {
      background: rgba(13, 13, 18, 0.82);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
    }

    .glass-panel-deep {
      background: rgba(8, 8, 12, 0.92);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
    }

    .pitch-lines {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 1;
      opacity: 0.22;
    }
    
    .pitch-glow {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 1;
      background: radial-gradient(850px 500px at 75% 0%, rgba(225, 29, 72, 0.14), transparent 70%);
    }

    .text-outline { color: transparent; -webkit-text-stroke: 1.5px rgba(255, 255, 255, 0.18); }
    .text-outline-red { color: transparent; -webkit-text-stroke: 1.5px rgba(255, 77, 97, 0.35); }
    .text-outline-purple { color: transparent; -webkit-text-stroke: 1.5px rgba(192, 132, 252, 0.4); }

    .sheen { position: relative; overflow: hidden; }
    .sheen::after {
      content: ""; position: absolute; inset: 0;
      background: linear-gradient(105deg, transparent 30%, rgba(255, 255, 255, 0.09) 48%, transparent 62%);
      transform: translateX(-120%); transition: transform 0.65s cubic-bezier(0.16, 1, 0.3, 1); pointer-events: none;
    }
    .sheen:hover::after { transform: translateX(120%); }

    @keyframes marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }
    .marquee-track { display: flex; width: max-content; animation: marquee 45s linear infinite; }
    .marquee-track:hover { animation-play-state: paused; }
    .marquee-mask {
      mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent);
      -webkit-mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent);
    }

    ::-webkit-scrollbar { width: 7px; height: 7px; }
    ::-webkit-scrollbar-track { background: #070709; }
    ::-webkit-scrollbar-thumb { background: #222228; border-radius: 4px; }
  </style>
</head>
<body class="relative selection:bg-crimson selection:text-white">

  <!-- Ambient Stadium Glow & Lines -->
  <div class="pitch-glow" aria-hidden="true"></div>
  <svg class="pitch-lines" viewBox="0 0 1200 900" preserveAspectRatio="xMidYMid slice" fill="none">
    <g stroke="rgba(255,255,255,0.06)" stroke-width="1.2">
      <rect x="60" y="60" width="1080" height="780" />
      <line x1="600" y1="60" x2="600" y2="840" />
      <circle cx="600" cy="450" r="140" />
      <circle cx="600" cy="450" r="4" fill="rgba(255,255,255,0.15)" />
      <rect x="60" y="240" width="170" height="420" />
      <rect x="970" y="240" width="170" height="420" />
      <rect x="60" y="340" width="60" height="220" />
      <rect x="1080" y="340" width="60" height="220" />
    </g>
  </svg>

  <!-- Notification Toast -->
  <div id="toast" class="fixed top-5 left-1/2 -translate-x-1/2 z-50 pointer-events-none opacity-0 transition-all duration-300 transform -translate-y-3 bg-panel border border-emerald-400/40 text-emerald-400 font-mono text-xs px-5 py-2.5 rounded-full shadow-2xl flex items-center gap-2">
    <span id="toast-msg">Operation completed</span>
  </div>

  <!-- NAVIGATION BAR (SUPPORT DESK REMOVED) -->
  <nav class="relative z-20 border-b border-white/10 px-6 sm:px-12 py-4 flex items-center justify-between backdrop-blur-md bg-ink/75">
    <div class="flex items-center gap-3.5">
      <div class="h-10 w-10 rounded-full border border-crimson/50 bg-black flex items-center justify-center font-display text-xs font-bold tracking-widest text-white shadow-[0_0_20px_rgba(225,29,72,0.4)]">
        RFF
      </div>
      <div>
        <p class="font-mono text-[9px] uppercase tracking-[0.28em] text-ember">Roblox Football Federation</p>
        <p class="font-display text-sm font-semibold uppercase tracking-[0.12em] text-white">Registry Database (271 Athletes)</p>
      </div>
    </div>
    
    <div class="flex items-center gap-3 font-mono text-xs">
      <button onclick="switchView('registry')" id="nav-btn-registry" class="px-4 py-2 rounded-full border border-crimson bg-crimson/20 text-white font-semibold transition-all">Registry</button>
      <button onclick="switchView('admin')" id="nav-btn-admin" class="px-4 py-2 rounded-full border border-crimson/40 bg-crimson/10 text-ember hover:bg-crimson hover:text-white transition-all flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
        Admin Room
      </button>

      <!-- ROBLOX VERIFICATION BUTTON -->
      <button onclick="openOAuthModal()" id="nav-roblox-btn" class="px-4 py-2 rounded-full border border-sky-500/50 bg-sky-500/10 text-sky-400 hover:bg-sky-500 hover:text-white transition-all flex items-center gap-2 font-bold shadow-[0_0_15px_rgba(0,162,255,0.2)]">
        <span id="nav-roblox-avatar" class="hidden h-5 w-5 rounded-full overflow-hidden border border-sky-400"></span>
        <svg id="nav-roblox-icon" class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.926 23.998L0 18.892 5.075.002 24 5.108l-5.074 18.89zM15.348 10.05l-5.282-1.417-1.414 5.283 5.282 1.415 1.414-5.281z"/></svg>
        <span id="nav-roblox-text">Verify Roblox</span>
      </button>
    </div>
  </nav>

  <!-- CLAIM BANNER -->
  <div id="claim-banner" class="relative z-10 max-w-[1300px] mx-auto px-5 sm:px-10 pt-6">
    <div onclick="openOAuthModal()" class="cursor-pointer p-4 rounded-2xl border border-sky-500/30 glass-panel flex flex-wrap items-center justify-between gap-4 hover:border-sky-500/60 transition-all shadow-xl">
      <div class="flex items-center gap-3">
        <div class="h-10 w-10 rounded-xl bg-sky-500/20 text-sky-400 flex items-center justify-center font-bold">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.926 23.998L0 18.892 5.075.002 24 5.108l-5.074 18.89zM15.348 10.05l-5.282-1.417-1.414 5.283 5.282 1.415 1.414-5.281z"/></svg>
        </div>
        <div>
          <h4 class="font-display text-sm font-semibold text-white">Roblox Account Verification Active</h4>
          <p class="font-mono text-xs text-fog">Link your Roblox username to claim your player card &amp; sync your live avatar across the database.</p>
        </div>
      </div>
      <span class="font-mono text-xs uppercase tracking-wider text-sky-400 flex items-center gap-1 font-bold">
        Connect Account →
      </span>
    </div>
  </div>

  <main class="relative z-10 max-w-[1300px] mx-auto px-5 sm:px-10 py-8">
    
    <!-- ==================== VIEW 1: REGISTRY ==================== -->
    <div id="view-registry" class="space-y-14">
      <section class="pt-4 pb-2">
        <p class="font-mono text-[11px] uppercase tracking-[0.32em] text-fog mb-3">— The official 271-player intelligence registry</p>
        <h1 class="font-display font-semibold uppercase leading-[0.92] tracking-tight">
          <span class="block text-[clamp(2.8rem,7.5vw,7.2rem)] text-white">Every player.</span>
          <span class="block text-[clamp(2.8rem,7.5vw,7.2rem)]">
            <span class="text-outline-red">Ranked.</span>
            <span class="text-ember drop-shadow-[0_0_30px_rgba(255,77,97,0.35)]">Contracted.</span>
          </span>
          <span class="block text-[clamp(2.8rem,7.5vw,7.2rem)] text-outline">On record.</span>
        </h1>

        <div class="mt-10 grid grid-cols-2 sm:grid-cols-4 gap-6 max-w-3xl border-y border-white/10 py-6">
          <div class="border-l-2 border-crimson pl-4">
            <div id="stat-total" class="font-display text-3xl sm:text-4xl font-semibold text-white">271</div>
            <div class="font-mono text-[10px] uppercase tracking-[0.2em] text-fog mt-1">Players registered</div>
          </div>
          <div class="border-l-2 border-purple-400 pl-4">
            <div id="stat-founders" class="font-display text-3xl sm:text-4xl font-semibold text-purple-400">5</div>
            <div class="font-mono text-[10px] uppercase tracking-[0.2em] text-fog mt-1">Founders Council</div>
          </div>
          <div class="border-l-2 border-gold pl-4">
            <div id="stat-goals" class="font-display text-3xl sm:text-4xl font-semibold text-white">0</div>
            <div class="font-mono text-[10px] uppercase tracking-[0.2em] text-fog mt-1">Goals Scored</div>
          </div>
          <div class="border-l-2 border-white/20 pl-4">
            <div id="stat-payroll" class="font-display text-3xl sm:text-4xl font-semibold text-white">$0</div>
            <div class="font-mono text-[10px] uppercase tracking-[0.2em] text-fog mt-1">Weekly Payroll</div>
          </div>
        </div>
      </section>

      <!-- MARQUEE RUNNER -->
      <div class="border-y border-white/10 py-3 marquee-mask overflow-hidden">
        <div id="marquee-list" class="marquee-track flex gap-8 items-center text-sm font-display font-semibold uppercase tracking-wider text-white/40"></div>
      </div>

      <!-- THE 5 FOUNDERS (SUPREME COUNCIL) -->
      <section>
        <div class="flex items-end justify-between mb-6">
          <div>
            <p class="font-mono text-[10px] uppercase tracking-[0.28em] text-founder font-bold">01 — Supreme Federation Authority</p>
            <h2 class="font-display text-3xl font-semibold uppercase text-white mt-1">The Founders</h2>
          </div>
          <p class="text-xs font-mono text-mist hidden sm:block">uK0Ab · THAHKYOU200 · Kai_wesh · respetoe · Mapw</p>
        </div>
        <div id="founders-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-4"></div>
      </section>

      <!-- DATABASE FILTERS & TABLE -->
      <section id="registry-db" class="space-y-6">
        <div>
          <p class="font-mono text-[10px] uppercase tracking-[0.28em] text-ember">02 — Registry &amp; Contracts</p>
          <h2 class="font-display text-3xl font-semibold uppercase text-white mt-1">Complete Roster Database</h2>
        </div>

        <div class="p-4 rounded-2xl glass-panel border border-white/10 space-y-4">
          <div class="flex flex-wrap items-center gap-3">
            <div class="relative flex-1 min-w-[240px]">
              <input id="filter-search" oninput="handleSearch(this.value)" type="search" placeholder="Search across all 271 athletes or clubs..." class="w-full bg-ink/80 border border-white/15 focus:border-crimson rounded-xl py-2.5 pl-4 pr-10 text-sm text-white placeholder:text-mist outline-none" />
            </div>

            <select id="filter-position" onchange="handlePositionFilter(this.value)" class="bg-ink/80 border border-white/15 focus:border-crimson rounded-xl py-2.5 px-3 text-xs font-mono uppercase text-white outline-none">
              <option value="">All Positions</option>
              <option value="GK">Goalkeeper (GK)</option>
              <option value="CB">Center Back (CB)</option>
              <option value="LB">Left Back (LB)</option>
              <option value="RB">Right Back (RB)</option>
              <option value="CDM">Defensive Mid (CDM)</option>
              <option value="CM">Center Mid (CM)</option>
              <option value="CAM">Attacking Mid (CAM)</option>
              <option value="LW">Left Wing (LW)</option>
              <option value="RW">Right Wing (RW)</option>
              <option value="ST">Striker (ST)</option>
            </select>

            <select id="filter-tier" onchange="handleTierFilter(this.value)" class="bg-ink/80 border border-white/15 focus:border-crimson rounded-xl py-2.5 px-3 text-xs font-mono uppercase text-white outline-none">
              <option value="">All Tiers</option>
              <option value="Founder">Founders (Rank 99)</option>
              <option value="S">Tier S</option>
              <option value="A">Tier A</option>
              <option value="B">Tier B</option>
              <option value="C">Tier C</option>
              <option value="D">Tier D</option>
            </select>

            <select id="filter-sort" onchange="handleSort(this.value)" class="bg-ink/80 border border-white/15 focus:border-crimson rounded-xl py-2.5 px-3 text-xs font-mono uppercase text-white outline-none">
              <option value="rank-desc">Rating: High → Low</option>
              <option value="rank-asc">Rating: Low → High</option>
              <option value="goals-desc">Goals: Most → Least</option>
              <option value="wage-desc">Wage: Highest</option>
              <option value="name-asc">Name: A → Z</option>
            </select>

            <div class="flex border border-white/15 rounded-xl overflow-hidden">
              <button onclick="setViewMode('grid')" id="view-mode-grid" class="p-2.5 bg-crimson text-white"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M5 3a2 2 0 00-2 2v2a2 2 0 002 2h2a2 2 0 002-2V5a2 2 0 00-2-2H5zM5 11a2 2 0 00-2 2v2a2 2 0 002 2h2a2 2 0 002-2v-2a2 2 0 00-2-2H5zM11 5a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V5zM11 13a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg></button>
              <button onclick="setViewMode('list')" id="view-mode-list" class="p-2.5 bg-panel text-fog hover:text-white"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M3 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd"/></svg></button>
            </div>

            <button onclick="exportCSV()" class="border border-crimson/40 bg-crimson/10 hover:bg-crimson text-ember hover:text-white font-mono text-xs px-3.5 py-2.5 rounded-xl transition-all flex items-center gap-1.5">CSV Export</button>
          </div>

          <div class="flex items-center gap-2 pt-2 border-t border-white/5 flex-wrap">
            <span class="font-mono text-[10px] uppercase text-mist tracking-wider">Rating Tiers:</span>
            <div id="dynamic-rank-chips" class="flex items-center gap-2 flex-wrap"></div>
            <span id="results-count" class="ml-auto font-mono text-xs text-fog">271 records</span>
          </div>
        </div>

        <div id="players-container" class="min-h-[300px]"></div>
        <div id="load-more-container" class="text-center pt-4"></div>
      </section>
    </div>

    <!-- ==================== VIEW 2: ADMIN CONTROL ROOM ==================== -->
    <div id="view-admin" class="hidden space-y-8">
      
      <!-- Staff Authentication Header -->
      <div class="p-6 rounded-2xl glass-panel border border-white/10 flex flex-wrap items-center justify-between gap-4 shadow-2xl">
        <div class="flex items-center gap-3.5">
          <div class="h-12 w-12 rounded-xl bg-crimson/20 border border-crimson/40 text-ember flex items-center justify-center font-display text-lg font-bold">
            <span id="admin-avatar-initial">?</span>
          </div>
          <div>
            <div class="flex items-center gap-2">
              <h2 id="current-user-display" class="font-display text-xl font-semibold text-white">Staff Login Required</h2>
              <span id="current-user-role-badge" class="px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold uppercase tracking-wider bg-white/10 text-fog">
                Locked
              </span>
            </div>
            <p id="admin-perms-desc" class="font-mono text-xs text-mist">Please authenticate with your staff password to unlock federation controls.</p>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <button onclick="openStaffLoginModal()" class="px-5 py-2.5 bg-crimson hover:bg-ember text-white rounded-xl text-xs font-mono uppercase font-bold flex items-center gap-1.5 shadow-lg">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg>
            Enter Staff Key
          </button>
          <button onclick="logoutStaff()" id="staff-logout-btn" class="hidden px-3 py-2 border border-white/15 hover:border-white/30 text-xs font-mono text-fog hover:text-white rounded-xl">
            Lock
          </button>
        </div>
      </div>

      <!-- Admin Main Controls Container (Locked by default) -->
      <div id="admin-main-controls" class="space-y-6 opacity-40 pointer-events-none transition-opacity duration-300">
        <div class="flex border-b border-white/10 gap-6 font-mono text-xs uppercase tracking-wider">
          <button onclick="switchAdminTab('roster')" id="admin-tab-btn-roster" class="pb-3 border-b-2 border-crimson text-white font-semibold">Roster Dossier Management</button>
          <button onclick="switchAdminTab('members')" id="admin-tab-btn-members" class="pb-3 border-b-2 border-transparent text-mist hover:text-white">Accounts &amp; Hierarchy Guard</button>
          <button onclick="switchAdminTab('audit')" id="admin-tab-btn-audit" class="pb-3 border-b-2 border-transparent text-mist hover:text-white">Security Audit Log</button>
        </div>

        <!-- Tab 1: Roster Dossier Table -->
        <div id="admin-tab-roster" class="space-y-4">
          <div class="flex justify-between items-center">
            <p class="text-xs font-mono text-mist">Click "Edit Dossier" to modify athlete stats, club, or toggle suspension.</p>
            <button onclick="openNewPlayerModal()" id="btn-add-player" class="px-4 py-2 bg-crimson hover:bg-ember text-white rounded-xl text-xs font-mono uppercase tracking-wider">+ Register New Player</button>
          </div>
          <div class="overflow-x-auto rounded-2xl border border-white/10 glass-panel max-h-[600px] overflow-y-auto">
            <table class="w-full text-left text-sm">
              <thead class="sticky top-0 border-b border-white/10 font-mono text-[10px] uppercase tracking-wider text-mist bg-panel/90 z-10">
                <tr>
                  <th class="p-3.5">Athlete</th>
                  <th class="p-3.5">Tier</th>
                  <th class="p-3.5">Pos</th>
                  <th class="p-3.5">Team</th>
                  <th class="p-3.5 text-right">Rating</th>
                  <th class="p-3.5 text-right">G / A</th>
                  <th class="p-3.5 text-right">Wage</th>
                  <th class="p-3.5 text-center">Status</th>
                  <th class="p-3.5 text-right">Action</th>
                </tr>
              </thead>
              <tbody id="admin-roster-tbody" class="divide-y divide-white/5 font-mono text-xs"></tbody>
            </table>
          </div>
        </div>

        <!-- Tab 2: Member Hierarchy (Banning & Ranks Locked to Super Admin) -->
        <div id="admin-tab-members" class="hidden space-y-4">
          <div id="admin-members-list" class="space-y-3"></div>
        </div>

        <!-- Tab 3: Security Audit Log -->
        <div id="admin-tab-audit" class="hidden space-y-3">
          <div id="audit-log-container" class="space-y-2"></div>
        </div>
      </div>
    </div>
  </main>

  <!-- STAFF PASSWORD AUTHENTICATION MODAL -->
  <div id="staff-login-modal" class="fixed inset-0 z-50 bg-black/85 backdrop-blur-md hidden flex items-center justify-center p-4">
    <div class="glass-panel-deep border border-white/20 rounded-3xl w-full max-w-md p-7 space-y-5 shadow-2xl relative">
      <div class="flex items-center justify-between border-b border-white/10 pb-4">
        <div>
          <h3 class="font-display text-lg font-semibold text-white">Staff Key Authentication</h3>
          <p class="font-mono text-xs text-fog">Enter your authorization password</p>
        </div>
        <button onclick="closeStaffLoginModal()" class="text-fog hover:text-white">✕</button>
      </div>

      <div class="space-y-3">
        <div>
          <label class="block font-mono text-[10px] uppercase text-fog mb-1">Staff Access Password</label>
