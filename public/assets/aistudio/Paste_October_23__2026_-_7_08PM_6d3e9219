      const stats = [
        { id: "pac", val: p.pace },
        { id: "sho", val: p.shooting },
        { id: "pas", val: p.passing },
        { id: "dri", val: p.dribbling },
        { id: "def", val: p.defending },
        { id: "phy", val: p.physical }
      ];

      stats.forEach(s => {
        document.getElementById(`stat-val-${s.id}`).innerText = s.val;
        document.getElementById(`stat-bar-${s.id}`).style.width = `${s.val}%`;
      });

      document.getElementById("dossier-modal").classList.remove("hidden");
    }

    function closeDossier() { document.getElementById("dossier-modal").classList.add("hidden"); }

    /* ====================================================================
       5. ADMIN ROOM CONTROLLER
       ==================================================================== */
    function renderAdminRoster() {
      const tbody = document.getElementById("admin-roster-tbody");
      tbody.innerHTML = players.map(p => {
        const av = getRobloxAvatarUrl(p.username);
        return `
        <tr class="hover:bg-white/5 transition-colors">
          <td class="p-3.5 font-display text-sm font-semibold text-white flex items-center gap-2">
            <div class="relative h-6 w-6 rounded-full overflow-hidden border border-white/10 bg-ink shrink-0">
              <img src="${av}" class="h-full w-full object-cover" onerror="this.classList.add('hidden'); this.nextElementSibling.classList.remove('hidden');" />
              <div class="monogram-fallback hidden h-full w-full flex items-center justify-center font-display text-[10px] font-bold text-white bg-gradient-to-br from-white/10 to-transparent">
                ${p.username.charAt(0).toUpperCase()}
              </div>
            </div>
            ${p.username} ${p.verified ? '<span class="text-sky-400 text-xs">✓</span>' : ''}
          </td>
          <td class="p-3.5 ${p.tier === 'Founder' ? 'text-founder font-bold' : 'text-ember font-bold'}">${p.tier}</td>
          <td class="p-3.5 text-fog">${p.position}</td>
          <td class="p-3.5 text-mist">${p.club}</td>
          <td class="p-3.5 text-right font-display text-sm font-bold ${p.rating >= 99 ? 'text-gold' : 'text-white'}">${p.rating}</td>
          <td class="p-3.5 text-right text-mist">${p.goals} / ${p.assists}</td>
          <td class="p-3.5 text-right text-gold">$${p.wage.toLocaleString()}</td>
          <td class="p-3.5 text-center">${p.banned ? '<span class="text-yellow-400 font-bold">SUSPENDED</span>' : '<span class="text-emerald-400">ACTIVE</span>'}</td>
          <td class="p-3.5 text-right">
            <button onclick="openEditModal(${p.id})" class="px-3 py-1 rounded bg-white/10 hover:bg-crimson hover:text-white transition-all text-[11px]">Edit Dossier</button>
          </td>
        </tr>
        `;
      }).join("");
    }

    function renderAdminMembers() {
      const list = document.getElementById("admin-members-list");
      const isOwner = currentAuthUser.role === "owner";

      list.innerHTML = accounts.map(a => `
        <div class="p-4 rounded-xl glass-panel border border-white/10 flex flex-wrap items-center justify-between gap-4">
          <div>
            <div class="flex items-center gap-2">
              <span class="font-display text-base font-semibold text-white">@${a.username}</span>
              <span class="px-2 py-0.5 rounded text-[10px] font-mono uppercase font-bold bg-white/10 text-white">${a.role}</span>
              ${a.banned ? '<span class="px-2 py-0.5 rounded text-[10px] font-mono uppercase font-bold bg-red-500/20 text-red-400">BANNED</span>' : ''}
            </div>
            <p class="font-mono text-xs text-mist mt-0.5">Last active: ${a.lastActive}</p>
          </div>
          <div class="flex items-center gap-2">
            <!-- Rank Promotion: Locked to Owners Only -->
            <select onchange="updateAccountRole(${a.id}, this.value)" ${!isOwner ? 'disabled title="Only Super Admin can change ranks"' : ''} class="bg-ink/80 border border-white/15 rounded-lg px-2.5 py-1 text-xs font-mono text-white outline-none disabled:opacity-30">
              <option value="player" ${a.role === 'player' ? 'selected' : ''}>PLAYER</option>
              <option value="moderator" ${a.role === 'moderator' ? 'selected' : ''}>MODERATOR</option>
              <option value="owner" ${a.role === 'owner' ? 'selected' : ''}>OWNER</option>
            </select>
            <!-- Ban Action: Strictly Locked to Owners (Super Admin) -->
            <button onclick="toggleBanAccount(${a.id})" ${!isOwner ? 'disabled title="Only Super Admin can Ban accounts"' : ''} class="px-3 py-1 rounded border text-xs font-mono ${a.banned ? 'border-emerald-500/40 text-emerald-400' : 'border-red-500/40 text-red-400'} disabled:opacity-30">
              ${a.banned ? 'Unban' : 'Ban'}
            </button>
          </div>
        </div>
      `).join("");
    }

    function updateAccountRole(accountId, newRole) {
      if (currentAuthUser.role !== "owner") {
        showToast("PERMISSION DENIED: Moderators cannot promote or demote members.");
        renderAdminMembers();
        return;
      }
      const target = accounts.find(a => a.id === accountId);
      if (target) {
        target.role = newRole;
        recordAuditLog("ROLE_CHANGE", `@${target.username}`, `Changed role to: ${newRole}`);
        showToast(`Role updated to ${newRole}`);
        renderAdminMembers();
      }
    }

    function toggleBanAccount(accountId) {
      if (currentAuthUser.role !== "owner") {
        showToast("PERMISSION DENIED: Moderators cannot Ban members. Only Super Admins hold ban authority.");
        return;
      }
      const target = accounts.find(a => a.id === accountId);
      if (target) {
        target.banned = !target.banned;
        recordAuditLog(target.banned ? "ACCOUNT_BANNED" : "ACCOUNT_UNBANNED", `@${target.username}`, "Owner toggle.");
        showToast(`Account @${target.username} ${target.banned ? 'banned' : 'unbanned'}.`);
        renderAdminMembers();
      }
    }

    function renderAuditLogs() {
      const container = document.getElementById("audit-log-container");
      container.innerHTML = auditLogs.map(l => `
        <div class="p-3 rounded-xl bg-ink/70 border border-white/5 font-mono text-xs flex justify-between items-start gap-4">
          <div>
            <div class="flex items-center gap-2">
              <span class="text-ember font-bold">${l.action}</span>
              <span class="text-mist">by</span>
              <span class="text-white">@${l.actor}</span>
              <span class="text-mist">→</span>
              <span class="text-gold font-semibold">${l.target}</span>
            </div>
            <p class="text-fog text-[11px] mt-0.5">${l.detail}</p>
          </div>
          <span class="text-mist text-[10px] whitespace-nowrap">${l.timestamp}</span>
        </div>
      `).join("");
    }

    function openEditModal(id) {
      if (currentAuthUser.role !== "moderator" && currentAuthUser.role !== "owner") {
        showToast("Staff login required.");
        openStaffLoginModal();
        return;
      }
      const p = players.find(x => x.id === id);
      if (!p) return;

      document.getElementById("edit-modal-title").innerText = `Edit Dossier — @${p.username}`;
      document.getElementById("edit-player-id").value = p.id;
      document.getElementById("edit-username").value = p.username;
      document.getElementById("edit-club").value = p.club;
      document.getElementById("edit-pos").value = p.position;
      document.getElementById("edit-rating").value = p.rating;
      document.getElementById("edit-goals").value = p.goals;
      document.getElementById("edit-assists").value = p.assists;
      document.getElementById("edit-wage").value = p.wage;
      document.getElementById("edit-clause").value = p.releaseClause;
      document.getElementById("edit-banned").checked = p.banned;

      document.getElementById("edit-modal").classList.remove("hidden");
    }

    function openNewPlayerModal() {
      if (currentAuthUser.role !== "owner") {
        showToast("Only Super Admins can register new athletes.");
        return;
      }
      document.getElementById("edit-modal-title").innerText = "Register New Athlete";
      document.getElementById("edit-player-id").value = "";
      document.getElementById("edit-username").value = "";
      document.getElementById("edit-club").value = "Team Unknown";
      document.getElementById("edit-pos").value = "CM";
      document.getElementById("edit-rating").value = 60;
      document.getElementById("edit-goals").value = 0;
      document.getElementById("edit-assists").value = 0;
      document.getElementById("edit-wage").value = 100000;
      document.getElementById("edit-clause").value = 10000000;
      document.getElementById("edit-banned").checked = false;

      document.getElementById("edit-modal").classList.remove("hidden");
    }

    function closeEditModal() { document.getElementById("edit-modal").classList.add("hidden"); }

    function savePlayerDossier() {
      if (currentAuthUser.role !== "moderator" && currentAuthUser.role !== "owner") {
        showToast("Unauthorized.");
        return;
      }

      const idVal = document.getElementById("edit-player-id").value;
      const username = document.getElementById("edit-username").value.trim();
      const club = document.getElementById("edit-club").value.trim() || "Team Unknown";
      const position = document.getElementById("edit-pos").value;
      const rating = parseInt(document.getElementById("edit-rating").value) || 60;
      const goals = parseInt(document.getElementById("edit-goals").value) || 0;
      const assists = parseInt(document.getElementById("edit-assists").value) || 0;
      const wage = parseInt(document.getElementById("edit-wage").value) || 100000;
      const releaseClause = parseInt(document.getElementById("edit-clause").value) || 10000000;
      const banned = document.getElementById("edit-banned").checked;

      if (!username) {
        showToast("Athlete username required.");
        return;
      }

      if (idVal) {
        const p = players.find(x => x.id === parseInt(idVal));
        if (p) {
          p.username = username;
          p.club = club;
          p.position = position;
          p.rating = rating;
          p.goals = goals;
          p.assists = assists;
          p.wage = wage;
          p.releaseClause = releaseClause;
          p.banned = banned; // Allowed for Mods & Admins
          p.avatarUrl = getRobloxAvatarUrl(username);

          recordAuditLog("UPDATE_DOSSIER", `@${username}`, `Rating: ${p.rating}, Suspended: ${banned}`);
          showToast(`Saved changes for @${username}`);
        }
      } else {
        const newId = Date.now();
        players.push({
          id: newId,
          username,
          tier: "D",
          club,
          position,
          rating,
          pace: 70, shooting: 65, passing: 65, dribbling: 65, defending: 55, physical: 65,
          appearances: 0,
          goals, assists,
          foot: "Right",
          wage,
          releaseClause,
          banned,
          verified: false,
          avatarUrl: getRobloxAvatarUrl(username),
          scoutingReport: "Newly registered athlete in federation database."
        });
        recordAuditLog("REGISTER_PLAYER", `@${username}`, `Created card with Rating: ${rating}`);
        showToast(`Registered new player: @${username}`);
      }

      closeEditModal();
      renderSummaryStats();
      renderDynamicRankChips();
      renderPlayerDatabase();
      renderAdminRoster();
    }

    function exportCSV() {
      const list = getFilteredPlayers();
      const headers = ["username", "tier", "rating", "position", "club", "wage", "releaseClause", "goals", "assists", "appearances", "banned"];
      const rows = list.map(p => [
        `"${p.username}"`, `"${p.tier}"`, p.rating, `"${p.position}"`, `"${p.club}"`, p.wage, p.releaseClause, p.goals, p.assists, p.appearances, p.banned
      ]);
      const csvContent = "data:text/csv;charset=utf-8," + [headers.join(","), ...rows.map(e => e.join(","))].join("\n");
      const encodedUri = encodeURI(csvContent);
      const link = document.createElement("a");
      link.setAttribute("href", encodedUri);
      link.setAttribute("download", `rff-roster-export.csv`);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      showToast(`Exported ${list.length} records to CSV.`);
    }

    window.addEventListener("DOMContentLoaded", () => {
      checkOAuthCallback();
      renderSummaryStats();
      renderDynamicRankChips();
      renderPlayerDatabase();
      renderAdminRoster();
      renderAdminMembers();
      renderAuditLogs();
    });
  </script>
</body>
</html>